# === G0GI Market-Bot · Konfiguration ===
# Kopiere diese Datei nach .env und trag deine Werte ein.

# Server
MC_HOST=hugosmp.net
MC_PORT=25565
MC_VERSION=1.21.11

# Account: AUTH=offline braucht nur den USERNAME.
# AUTH=microsoft startet den Device-Code-Flow (Code in der Konsole merken
# und auf microsoft.com/link eingeben) — es wird KEIN Passwort gespeichert.
AUTH=offline
USERNAME=G0GI_Market

# Regeln: Kommando, das der Bot nach dem Join ausführt (z. B. /rules).
# Der Bestätigungs-Button im GUI wird automatisch gesucht und geklickt.
RULES_COMMAND=/rules

# Scraper
AH_COMMAND=/ah
ORDER_COMMAND=/order
SCAN_INTERVAL_MIN=30
PAGE_DELAY_MS=250
MAX_PAGES=200

# Anti-AFK: alle 4 Minuten einmal unauffällig den Arm schwenken.
# Der Bot farmt nichts — er steht nur rum und liest den Markt.
ANTI_AFK=true

# Debug: schreibt rohe GUI-Dumps nach backend/data/dumps/
SCRAPER_DEBUG=false

# API
API_PORT=8080
# Wenn true, werden einmalig Demo-Preisdaten erzeugt (zum Frontend-Testen,
# bevor der Bot echte Scans liefert).
SEED_DEMO_DATA=true
